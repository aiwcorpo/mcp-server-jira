<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent/aggregator of the MCP server. Cross-cutting concerns (internal JWT of the gateway, backend
  credential, audit, tool errors, MCP transport) come from mcp-platform-starter and are not duplicated here.
  groupId pl.aiwcorpo.mcp.<system> keeps the modules of different servers apart in the artifact repository;
  new-server.sh sets it. Intra-reactor dependencies use ${project.groupId}, the platform stays pl.aiwcorpo.mcp.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pl.aiwcorpo.mcp.jira</groupId>
    <artifactId>mcp-jira-parent</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <name>mcp-jira :: Parent</name>

    <!-- Must be the Spring Boot version mcp-platform-starter is built against. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>mcp-core</module>
        <module>mcp-application</module>
        <module>mcp-integration</module>
        <module>mcp-tools</module>
        <module>mcp-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mcp-platform.version>4.0.0</mcp-platform.version>
        <!-- Security fixes newer than the parent above; drop them once the starter moves to a Boot release that manages them. -->
        <tomcat.version>11.0.27</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <spring-framework.version>7.0.10</spring-framework.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <netty.version>4.2.19.Final</netty.version>
        <log4j2.version>2.25.5</log4j2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Pins the starter, mcp-platform-test, mcp-contracts and Spring AI for the whole server. -->
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-platform-bom</artifactId>
                <version>${mcp-platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Not managed by Boot; cedar-java brings 33.5.0-jre, older than its security fix. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
