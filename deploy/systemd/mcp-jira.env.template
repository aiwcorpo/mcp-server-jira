# Environment of the mcp-jira service: copy to /etc/mcp-jira/mcp-jira.env (root:mcp, 0640).
# The real file is never committed. Prefer rendering it from the secrets store at deploy time.
# No backend credential here: the gateway sends the user's credential with every call (C3).

# The public key set of the gateway: https://<domain of the platform>/.well-known/mcp-jwks.json
MCP_GATEWAY_JWKS_URI=
# Only when the certificate of the platform comes from a CA that the JVM does not know:
# JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/etc/mcp-jira/truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12 -Djavax.net.ssl.trustStorePassword=changeit

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# Kept between starts (StateDirectory= of the unit creates /var/lib/mcp-jira): the generated self-signed certificate and the cursor key.
MCP_STATE_DIR=/var/lib/mcp-jira/state

# Backend system API; MCP_JIRA_SSL_BUNDLE only when it needs a non-default trust store.
MCP_JIRA_URL=

# Writes while the probe cannot read the version of Jira (serverInfo blocked in front of Jira). Default false: only
# reads. Never opens writes for a version known to be older than 9.12, 12.x or newer, or Cloud.
MCP_JIRA_WRITES_ON_UNKNOWN_VERSION=false

MCP_ACCEPTED_CREDENTIAL_TYPES=user-secret

# Your own certificate instead of the generated one (files readable by the mcp user):
# MCP_TLS_CERT=/etc/mcp-jira/tls/server.crt
# MCP_TLS_KEY=/etc/mcp-jira/tls/server.key
# or a PKCS12 keystore with its password:
# MCP_TLS_KEYSTORE=/etc/mcp-jira/tls/keystore.p12
# MCP_TLS_STORE_PASSWORD=

# Several instances behind a balancer only: Redis for the one-time jti, the same cursor key (Base64 of 32 bytes) and the same certificate.
# MCP_REDIS_HOST=
# MCP_REDIS_PORT=6379
# MCP_REDIS_USER=
# MCP_REDIS_PASSWORD=
# MCP_PAGING_CURSOR_KEY=
