# Environment of the mcp-jira service: copy to /etc/mcp-jira/mcp-jira.env (root:mcp, 0640).
# The real file is never committed. Prefer rendering it from the secrets store at deploy time.
# No backend credential here: the gateway sends the user's credential with every call (C3).

# mTLS: this server's certificate (SAN mcp-jira.internal) and the internal CA, both PKCS12.
MCP_TLS_KEYSTORE=/etc/mcp-jira/tls/keystore.p12
MCP_TLS_TRUSTSTORE=/etc/mcp-jira/tls/truststore.p12
MCP_TLS_STORE_PASSWORD=

# Gateway: JWKS of the internal JWT (C2), served over TLS signed by the internal CA.
MCP_GATEWAY_JWKS_URI=https://mcp-gateway.internal:8443/.well-known/jwks.json

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# Key of the paging cursors (Base64, at least 32 bytes: openssl rand -base64 32). The same value on every instance;
# without it each instance draws its own and a cursor issued by another instance is refused.
MCP_PAGING_CURSOR_KEY=

# Backend system API; MCP_JIRA_SSL_BUNDLE only when it needs a non-default trust store.
MCP_JIRA_URL=

# Writes while the probe cannot read the version of Jira (serverInfo blocked in front of Jira). Default false: only
# reads. Never opens writes for a version known to be older than 9.12, 12.x or newer, or Cloud.
MCP_JIRA_WRITES_ON_UNKNOWN_VERSION=false

# Redis for one-time jti (ACL user mcp-jira, keys jti:mcp-jira:*, command SET).
MCP_REDIS_HOST=
MCP_REDIS_PORT=6379
MCP_REDIS_USER=mcp-jira
MCP_REDIS_PASSWORD=

# Signed policy bundle (C7) of the policy repository; the same bundle the gateway evaluates. The server does not start
# without a first bundle. The public key is Ed25519 (SPKI PEM); the state dir keeps the last accepted revision.
MCP_POLICY_URL=https://policies.internal/policies/main/latest.json
MCP_POLICY_KEY_ID=
MCP_POLICY_PUBLIC_KEY_FILE=/etc/mcp-jira/policies-main.pub.pem
MCP_POLICY_STATE_DIR=/var/lib/mcp-jira/policy-state

# Registration data of the manifest (GET /mcp-manifest): the address the gateway reaches this server at.
MCP_INTERNAL_URL=https://mcp-jira.internal:8443/mcp
MCP_ACCEPTED_CREDENTIAL_TYPES=user-secret
