# systemd unit: /etc/systemd/system/mcp-jira.service
#   systemctl daemon-reload && systemctl enable --now mcp-jira
[Unit]
Description=MCP server mcp-jira (behind the MCP gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp
Group=mcp
# Secrets and addresses (mcp-jira.env.template); logs go to journald (the fingerprint of the certificate is in the first lines).
# /var/lib/mcp-jira holds the generated certificate and the cursor key between starts.
StateDirectory=mcp-jira
EnvironmentFile=/etc/mcp-jira/mcp-jira.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -jar /opt/mcp-jira/mcp-jira.jar

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# The JIT needs writable and executable memory.
MemoryDenyWriteExecute=false
ReadOnlyPaths=/etc/mcp-jira /opt/mcp-jira
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
